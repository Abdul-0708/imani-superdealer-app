# Local secrets - real DB credentials live only on the server
public_html/lib/config.local.php

# Local dev MySQL data (portable MariaDB used for testing)
.mdb/

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Uploaded receipt photos are BUSINESS EVIDENCE, not source. They belong on the
# server (and in its backups), never in the repository - a proof image committed
# here would be readable by anyone with repo access, for ever, and would survive
# any deletion made through the app.
public_html/uploads/proofs/*
!public_html/uploads/proofs/.gitkeep

# Local dev state. data/.jwtsecret is the token SIGNING KEY: anyone holding it
# can mint a valid session for any role, OM included. It belongs on the machine
# that generated it and nowhere else - least of all in a public repository,
# where a single commit would expose it for ever and rotating it would not
# un-publish it. dev-db.json is throwaway local data with real names in it.
data/
